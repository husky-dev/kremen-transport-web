{
  "name": "kremen-transport-web",
  "version": "1.0.6",
  "main": "index.js",
  "author": "Jaroslav Khorishchenko <jaro@husky-dev.me>",
  "license": "MIT",
  "scripts": {
    "start": "node esbuild.js --serve",
    "dist": "node esbuild.js",
    "lint": "npm run lint:types && npm run lint:eslint && npm run lint:format",
    "lint:types": "tsc --build --noEmit",
    "lint:types:watch": "tsc --build --noEmit --watch",
    "lint:eslint": "eslint src --fix",
    "lint:format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "snippets": "npx md2snipp --root .vscode/snippets --output .vscode",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@vis.gl/react-google-maps": "1.9.0",
    "axios": "1.20.0",
    "color": "5.0.3",
    "daisyui": "5.7.28",
    "dompurify": "3.4.14",
    "marked": "18.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/color": "4.2.1",
    "@types/googlemaps": "3.43.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "autoprefixer": "10.5.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "tmp": "0.2.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "zod": "4.5.4"
  }
}
